<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ffw_safety_qp</name>
  <version>0.1.0</version>
  <description>QP-based capsule-vs-pointcloud collision shield for FFW leader-follower teleoperation.</description>
  <maintainer email="ai.learning.rbtai@gmail.com">robotis</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>pinocchio</depend>
  <depend>urdfdom</depend>
  <depend>urdfdom_headers</depend>
  <depend>libpcl-all-dev</depend>
  <depend>osqp_eigen_vendor</depend>
  <depend>cyclo_motion_controller_core</depend>

  <exec_depend>ffw_safety</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
